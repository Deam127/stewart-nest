{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stewart-nest",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // lets notify() send phone notifications after the response has gone (src/push.js)
  "compatibility_flags": ["nodejs_als"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stewart-nest",
      // Only needed when deploying to Cloudflare: run `npx wrangler d1 create stewart-nest`
      // and paste the database_id it prints here. Local dev works without it.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Photos (inventory pictures, chat photos). For Cloudflare: `npx wrangler r2 bucket create stewart-nest-photos`
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "stewart-nest-photos" }]
}
